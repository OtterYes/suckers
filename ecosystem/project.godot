; Godot project settings. Most of these are easier to change in the editor
; (Project > Project Settings), which rewrites this file for you.

config_version=5

[application]

config/name="Agent Ecosystem"
config/description="A local desktop world of AI agents for school, business, TikTok, and Roblox work."
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]

App="*res://app.gd"

[display]

window/size/viewport_width=1440
window/size/viewport_height=900
window/stretch/aspect="expand"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
